# Server-side only. Never rename this to VITE_GITHUB_TOKEN.
GITHUB_TOKEN=github_pat_your_read_only_token

# Safe for the browser. Find these under Supabase Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Server-side only. Never expose this with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
