{
  "functions": {
    "api/**/*.ts": {
      "regions": ["sin1"]
    }
  },
  "rewrites": [
    { "source": "/history", "destination": "/index.html" },
    { "source": "/statistics", "destination": "/index.html" },
    { "source": "/stats", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/leaderboard", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/profile/:userId", "destination": "/index.html" }
  ]
}
